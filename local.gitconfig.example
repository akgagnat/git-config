# This file is copied to ~/.config/git-config/local.gitconfig by install.sh.
# It remains outside the repository and is intentionally never committed.

# Your identity. install.sh fills these in from the values you enter, or from
# --name/--email. They stay unset until you supply real ones, so that Git
# refuses to commit rather than silently authoring commits as a placeholder.
[user]

# Optional signing configuration. Uncomment and set values appropriate to this
# machine; never store private keys in this repository.
#
# [commit]
# 	gpgSign = true
#
# [user]
# 	signingKey = YOUR_PUBLIC_KEY_FINGERPRINT
